# IP-SAKTI Sahayak - Environment Configuration

# Optional: Bhashini API Credentials (Govt of India - MeitY)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Optional: Gemini API Key (for LLM-based Hinglish Normalization & Generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Local / Default Settings
DEFAULT_LANGUAGE=hindi
DEFAULT_RESPONSE_STYLE=hinglish  # Options: hinglish, devanagari, english
VOICE_OUTPUT_DIR=./audio_output
ENABLE_BHASHINI_MOCK=true       # Set to true to test Bhashini workflow without live API keys
